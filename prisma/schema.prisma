generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SUPER_ADMIN
  ADMIN
  CLIENT
  SELLER
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String
  fullName       String?
  imageUrl       String?

  admins         Admin[]
  sellers        Seller[] 
  clients        Client[] 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id     Int    @id @default(autoincrement())
  status Status @default(PENDING)
  role   Roles  @default(ADMIN)
  userId Int?   @unique
  user   User?  @relation(fields: [userId], references: [id])
}

model Seller { 
  id     Int    @id @default(autoincrement())
  status Status @default(PENDING)
  role   Roles  @default(SELLER)
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Client {
  id     Int    @id @default(autoincrement())
  status Status @default(PENDING)
  role   Roles  @default(CLIENT)
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}